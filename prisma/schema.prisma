// Lazarus data model — Phase 1 MVP
// Multi-tenant from day one: every record scopes to a Tenant (a client company).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Platform-level settings (e.g. integration API keys). Values are encrypted at
// rest by the app (AES-256-GCM) — never stored or returned in plaintext.
model Setting {
  key       String   @id
  value     String   // encrypted blob: iv:tag:ciphertext (base64)
  updatedAt DateTime @updatedAt
}

// Per-tenant encrypted secrets (a tenant's own sending credentials).
model TenantSecret {
  tenantId  String
  key       String
  value     String   // encrypted blob: iv:tag:ciphertext (base64)
  updatedAt DateTime @updatedAt

  @@id([tenantId, key])
}

// Single-use tokens for password reset + email verification.
model AuthToken {
  token     String   @id
  userId    String
  kind      String   // "reset" | "verify"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  // Per-tenant config / connected accounts
  crmConnection CrmConnection?
  twilioNumber  String?  // provisioned per tenant (Messaging Service SID)
  emailSender   String?
  brandVoice    String?  // tone/voice guidance for the re-nurture agent
  // Per-tenant sending gateway (their own accounts); secrets live in TenantSecret
  twilioAccountSid String?
  smtpHost  String?
  smtpPort  Int?
  smtpUser  String?
  stripeCustomerId   String?
  subscriptionStatus String?
  // Research feature flag + split-test rollout
  researchEnabled    Boolean @default(false)
  researchRolloutPct Int     @default(0)   // 0-100: % of leads assigned to research-on
  researchMonthlyCap Int     @default(0)   // spend cap in cents; 0 = no research
  createdAt     DateTime @default(now())
  leads         Lead[]
  campaigns     Campaign[]
  users         User[]
}

// A person who logs in. Always belongs to exactly one Tenant (multi-tenant rule).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         String   @default("user") // "user" | "admin" (platform super-admin)
  passwordHash String
  emailVerified Boolean @default(false)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model CrmConnection {
  id           String  @id @default(cuid())
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  tenantId     String  @unique
  provider     String  // "hubspot" (Phase 1); "zoho" later
  accessToken  String    // encrypted at rest (AES-256-GCM)
  refreshToken String?   // encrypted at rest (AES-256-GCM)
  expiresAt    DateTime?
  lastSyncedAt DateTime?
}

model Lead {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  // Identity
  firstName   String?
  lastName    String?
  email       String?
  phoneE164   String?  // normalized at ingest
  company     String?
  crmId       String?  // id in the source CRM
  // Consent (TCPA / CAN-SPAM) — must be set before any outreach
  smsConsent  Boolean  @default(false)
  emailConsent Boolean @default(false)
  consentSource String?
  optedOut    Boolean  @default(false)
  // Split-test cohort assignment (stable for the lead's life)
  researchCohort String?  // "treatment" | "control" | null (unassigned)
  // Research output
  researchBrief Json?
  researchCostCents Int   @default(0)
  revenueCents Int        @default(0) // realized revenue when the lead converts
  // Outreach state
  status      String   @default("new") // new | researching | queued | engaged | replied | booked | dead
  createdAt   DateTime @default(now())
  events      OutreachEvent[]
  enrollments Enrollment[]

  @@index([tenantId, status])
  @@index([tenantId, phoneE164])
}

model Campaign {
  id        String  @id @default(cuid())
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  tenantId  String
  name      String
  sequence  Json    // steps: channel, delay, template/voice, branching
  active    Boolean @default(false)
  sendMode  String  @default("internal") // internal = platform gateway | backoffice = tenant's own Twilio/SMTP
  createdAt DateTime @default(now())
  enrollments Enrollment[]
}

// A lead's progression through a campaign sequence — the engine's unit of work.
model Enrollment {
  id         String   @id @default(cuid())
  tenantId   String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  step       Int      @default(0) // index of the NEXT step to send
  status     String   @default("active") // active | done | stopped
  nextRunAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([leadId, campaignId])
  @@index([status, nextRunAt])
}

model OutreachEvent {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id])
  leadId    String
  channel   String   // sms | email
  direction String   // outbound | inbound
  body      String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([leadId])
}
