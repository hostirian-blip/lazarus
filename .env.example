# Lazarus environment contract — safe to commit. Copy to .env and fill values.
NODE_ENV=production
PORT=3001
NEXTAUTH_URL=https://lazarus.vrroom.io
NEXTAUTH_SECRET=            # generate with: openssl rand -base64 32
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/DBNAME?schema=public

# Integrations (Phase 1 — fill as implemented)
ANTHROPIC_API_KEY=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EMAIL_PROVIDER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
